# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Google OAuth (used by Supabase Auth for "Continue with Google")
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# Only needed for local `supabase start`; hosted projects are configured in the
# Supabase Dashboard instead (Authentication > Providers > Google).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Background job worker (app/api/jobs/process/route.ts). Generate with
# `openssl rand -base64 32`. Set the same value in Vercel's project env vars
# (exactly named CRON_SECRET so Vercel Cron auto-sends it as a Bearer token)
# and in any Supabase Database Webhook you point at this route.
CRON_SECRET=

# Deployment
NODE_ENV=development
